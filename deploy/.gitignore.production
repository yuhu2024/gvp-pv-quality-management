# ==============================================================
# 君合盟药物警戒培训管理系统 - 生产环境 .gitignore
# 部署时同步到服务器
# ==============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# 虚拟环境
venv/
env/
.venv/

# 环境变量（敏感信息！）
.env
.env.production
.env.local

# 数据库
*.sqlite3
*.sqlite

# 静态文件收集目录
staticfiles/

# 日志
logs/
*.log

# 上传文件（生产环境按照备份策略管理）
media/uploads/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db