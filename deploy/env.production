# 君合盟药物警戒培训管理系统 - 生产环境变量模板
# 使用方法: cp env.production .env 并修改实际值
# 安全: 部署后 chmod 600 .env

# ===== Django 安全配置 =====
# 生成强密钥: openssl rand -base64 48
DJANGO_SECRET_KEY="your-secret-key-here"
DJANGO_DEBUG="False"
DJANGO_ALLOWED_HOSTS="train.yourcompany.com,your-server-ip"

# ===== PostgreSQL 数据库 =====
DB_ENGINE="django.db.backends.postgresql"
DB_NAME="training_db"
DB_USER="training_user"
DB_PASSWORD="your-strong-db-password"
DB_HOST="localhost"
DB_PORT="5432"

# ===== 文件路径 =====
STATIC_ROOT="/var/www/training_system/staticfiles"
MEDIA_ROOT="/var/www/training_system/media"

# ===== 邮件服务（用于密码重置） =====
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.yourcompany.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"
EMAIL_HOST_USER="noreply@yourcompany.com"
EMAIL_HOST_PASSWORD="your-email-password"
DEFAULT_FROM_EMAIL="培训系统 <noreply@yourcompany.com>"

# ===== Redis 缓存（可选，提高性能） =====
REDIS_URL="redis://localhost:6379/1"

# ===== 生产环境安全配置 =====
SESSION_COOKIE_SECURE="True"
CSRF_COOKIE_SECURE="True"
SECURE_SSL_REDIRECT="True"
SECURE_HSTS_SECONDS="31536000"
SECURE_HSTS_INCLUDE_SUBDOMAINS="True"
SECURE_HSTS_PRELOAD="True"

# ===== CSRF 信任域名 =====
CSRF_TRUSTED_ORIGINS="http://db8mcom.cn,http://www.db8mcom.cn,http://120.27.196.230"