# ============================================
# 君合盟药物警戒培训管理系统 - 环境变量配置示例
# 复制此文件为 .env 并修改对应值
# ============================================

# Django 核心配置
DJANGO_SECRET_KEY=请替换为随机生成的密钥_使用_python3 -c "import secrets; print(secrets.token_hex(32))"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置（默认使用 SQLite，生产环境建议使用 PostgreSQL）
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=training_system
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# HTTPS 安全配置（生产环境启用）
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CSRF 信任域名
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://your-domain.com

# Redis 缓存（可选）
# REDIS_URL=redis://127.0.0.1:6379/0

# 邮件配置（可选）
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=your_email_password
# DEFAULT_FROM_EMAIL=君合盟药物警戒培训管理系统 <noreply@example.com>

# 大模型 API 配置（可选）
# LLM_PROVIDER=openai
# LLM_API_KEY=your_api_key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-3.5-turbo
